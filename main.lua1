-- ==========================================
-- 🛠️ Combined Script: Cash Exploit & Hitbox
-- ⌨️ Toggle Key: B (Press to Enable/Disable)
-- ==========================================

-- ⚙️ إعدادات الهيتبوكس
local TOGGLE_KEY = Enum.KeyCode.B
local HITBOX_SIZE = 3.0
local KEEP_HEAD_NORMAL = true

local Enabled = false
local Original = {}

-- 💰 دالة تشغيل سكربت الكاش
local function RunCashExploit()
    local success, err = pcall(function()
        local player = game.Players.LocalPlayer
        local stats = player:WaitForChild("leaderstats", 5)
        if stats then
            local cash = stats:WaitForChild("Cash", 5)
            if cash then
                local remoteFolder = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes") or game:GetService("ReplicatedStorage")

                for _, remote in pairs(remoteFolder:GetDescendants()) do
                    if remote:IsA("RemoteEvent") then
                        local name = remote.Name:lower()
                        if name:find("collect") or name:find("add") or name:find("cash") then
                            print("Targeting: " .. remote.Name)
                            remote:FireServer(999999999)
                            remote:FireServer(true)
                        end
                    end
                end

                cash.Value = 999999999
                -- تجنب التكرار المستمر المفرط لتفادي الـ Lag
                task.spawn(function()
                    while Enabled do
                        if cash.Value ~= 999999999 then
                            cash.Value = 999999999
                        end
                        task.wait(1)
                    end
                end)
            end
        end
    end)
    if not success then
        warn("Cash exploit error: ", err)
    end
end

-- 🎯 تحديث الهيتبوكس باستمرار أثناء التفعيل
game:GetService("RunService").RenderStepped:Connect(function()
    if not Enabled then return end
    for _, v in ipairs(game:GetService("Players"):GetPlayers()) do
        if v == game.Players.LocalPlayer or not v.Character or not v.Character:FindFirstChild("Head") then continue end
        local Head = v.Character.Head
        if not Original[v.UserId] then
            Original[v.UserId] = {Size = Head.Size, Transparency = Head.Transparency, CanCollide = Head.CanCollide}
        end
        -- تعديل حجم الهيدبوكس للضرب
        Head.Size = Vector3.new(HITBOX_SIZE, HITBOX_SIZE, HITBOX_SIZE)
        Head.Transparency = Original[v.UserId].Transparency
        Head.CanCollide = false
        local Mesh = Head:FindFirstChildWhichIsA("SpecialMesh")
        if Mesh then Mesh.Scale = Vector3.one end
    end
end)

-- ⏹️ إعادة الأوضاع لطبيعتها عند إيقاف السكربت
local function RestoreAll()
    for _, v in ipairs(game:GetService("Players"):GetPlayers()) do
        if v.Character and v.Character:FindFirstChild("Head") and Original[v.UserId] then
            local Head = v.Character.Head
            Head.Size = Original[v.UserId].Size
            Head.Transparency = Original[v.UserId].Transparency
            Head.CanCollide = Original[v.UserId].CanCollide
        end
    end
end

-- ⌨️ التحكم بالتشغيل والإيقاف عبر حرف B
game:GetService("UserInputService").InputBegan:Connect(function(Input, GP)
    if GP or Input.KeyCode ~= TOGGLE_KEY then return end
    Enabled = not Enabled
    
    if Enabled then
        print("✅ Hitbox & Cash Script Enabled!")
        RunCashExploit()
    else
        print("❌ Hitbox & Cash Script Disabled!")
        RestoreAll()
    end
end)
